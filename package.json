{
  "name": "jetacademie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run assets:pdf && bun --bun next dev",
    "build": "bun run assets:pdf && bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "BETTER_AUTH_URL=http://localhost:3000 NEXT_PUBLIC_APP_URL=http://localhost:3000 DATABASE_URL=\":memory:\" bun test",
    "curriculum": "bun scripts/curriculum.ts",
    "icons:generate": "bun scripts/generate-icons.ts",
    "db:migrate": "bun scripts/migrate-db.ts",
    "db:clean-curriculum": "bun scripts/clean-curriculum-db.ts",
    "sources:index": "python3 scripts/index-sources.py",
    "sources:search": "bun scripts/search-sources.ts",
    "editor:setup": "bun scripts/setup-curriculum-editor.ts",
    "assets:pdf": "bun scripts/prepare-pdf-assets.ts",
    "check": "bun run test && bun run lint && bun run format:check && bun run build",
    "test:postgres": "bun scripts/verify-postgres.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "@uiw/react-md-editor": "^4.2.3",
    "better-auth": "^1.7.16",
    "lucide-react": "^1.68.0",
    "motion": "^13.5.1",
    "next": "16.4.5",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
