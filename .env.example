# Application URL
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated list of other exact application origins (HTTPS in production).
AUTH_TRUSTED_ORIGINS=

# Independent curriculum editor at /duzenle. Empty credentials disable access.
# Generate local credentials: bun run editor:setup
# Copy the generated values to your production secrets; never commit them.
CURRICULUM_ADMIN_USERNAME=
CURRICULUM_ADMIN_PASSWORD_HASH=
CURRICULUM_ADMIN_SECRET=
CURRICULUM_ADMIN_ORIGIN=

# Better-Auth Secret (Generate via `openssl rand -base64 32`)
BETTER_AUTH_SECRET=development-secret-must-be-at-least-32-characters-long

# PostgreSQL Database Configuration
POSTGRES_USER=jetacademie
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=jetacademie
# Bind strictly to Tailscale IP (prevents public WAN exposure; set to 127.0.0.1 for local-only Docker)
PG_BIND_IP=100.80.51.7
# Host port 5433 avoids collision with existing PostgreSQL on port 5432
PG_HOST_PORT=5433

# New Compose installs: generate a separate password with openssl rand -hex 32.
# Set both variables below (use the same password, URL-encoded in APP_DATABASE_URL).
# Existing installations need a role/ownership migration before switching to this login.
POSTGRES_APP_PASSWORD=
APP_DATABASE_URL=

# Remote Tailscale / Local Bun CLI outside Compose (optional):
# DATABASE_URL=postgres://jetacademie:change-me-in-production@100.80.51.7:5433/jetacademie

# Server Configuration
PORT=3000
HOSTNAME=0.0.0.0
# Host port 3001 avoids collision with Dokploy dashboard on port 3000
HOST_PORT=3001
