# Application URL
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better-Auth Secret (Generate via `openssl rand -base64 32`)
BETTER_AUTH_SECRET=development-secret-must-be-at-least-32-characters-long

# PostgreSQL Database Configuration
POSTGRES_USER=jetacademie
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=jetacademie
# Bind strictly to Tailscale IP (prevents public WAN exposure)
PG_BIND_IP=100.80.51.7
# Host port 5433 avoids collision with existing PostgreSQL on port 5432
PG_HOST_PORT=5433

# Internal Docker Database URL (used inside container)
DATABASE_URL=postgres://jetacademie:change-me-in-production@localhost:5433/jetacademie

# Remote Tailscale Connection Example (for data migration or GUI tools):
# DATABASE_URL=postgres://jetacademie:change-me-in-production@100.80.51.7:5433/jetacademie

# Server Configuration
PORT=3000
HOSTNAME=0.0.0.0
# Host port 3001 avoids collision with Dokploy dashboard on port 3000
HOST_PORT=3001
